// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`plain-language real-data errors (AUG-366) > authority revoked 1`] = `"Error: This suite's test scope was revoked, so nothing was sent to your agent. A workspace owner revoked it in Settings → Targets. To test again, verify the target with \`augmentworks target verify <name>\` (or register it again with \`augmentworks target add\`), then create a new scope with \`augmentworks scope create --target <name> --suite <file>\`. Past results stay readable with \`augmentworks run report <run-id>\`. (TARGET_AUTHORITY_REVOKED)"`;

exports[`plain-language real-data errors (AUG-366) > budget exhausted 1`] = `"Error: This run used up its scope's allowance of 3 messages, 0 actions and 60 commands, counting sends whose outcome is unknown. The run stopped there and won't retry, because a retry could message your agent again. Each run gets the scope's allowance, so run fewer cases at a time: split the suite with \`augmentworks selection compile\` and run each part with \`augmentworks test --shard <shard-id>\`. (EXECUTION_BUDGET_EXHAUSTED)"`;

exports[`plain-language real-data errors (AUG-366) > machine key used for setup (CLI) 1`] = `"Error: Creating a test scope needs a workspace owner's login, and machine keys can't do it. Unset AUGMENTWORKS_API_KEY and run \`augmentworks login\` as an owner. (TARGET_OWNER_LOGIN_REQUIRED)"`;

exports[`plain-language real-data errors (AUG-366) > machine key used for setup (server) 1`] = `"Error: Machine keys can't register targets or create scopes. Setup needs a workspace owner's login: unset AUGMENTWORKS_API_KEY and run \`augmentworks login\`. Machine keys can run tests once a scope exists. (TARGET_AUTHORITY_REQUIRED)"`;

exports[`plain-language real-data errors (AUG-366) > no workspace statement 1`] = `"Error: This workspace hasn't accepted the real-data statement, so it can't run real-data tests. A workspace owner accepts it once by running \`augmentworks target add\` in a terminal, or in Settings → Targets. (TARGET_AUTHORITY_REQUIRED)"`;

exports[`plain-language real-data errors (AUG-366) > release unavailable 1`] = `"Error: AugmentWorks isn't accepting real-data tests right now. Nothing was sent to your agent. Try again later. Synthetic tests and \`augmentworks test --local --packet\` still run. (EXECUTION_RELEASE_UNAVAILABLE)"`;

exports[`plain-language real-data errors (AUG-366) > release unavailable, rate limited 1`] = `"Error: Too many real-data runs started in this workspace. Nothing was sent to your agent. Wait a few minutes and run the same command again. (EXECUTION_RELEASE_UNAVAILABLE)"`;

exports[`plain-language real-data errors (AUG-366) > scope expired 1`] = `"Error: This suite's test scope expired at 2026-10-01T00:00:00Z. Create a new one with \`augmentworks scope create --target <name> --suite <file>\`. An expired scope can't be reused. (TARGET_AUTHORITY_EXPIRED)"`;

exports[`plain-language real-data errors (AUG-366) > target not verified 1`] = `"Error: This suite's target isn't verified yet, so it can't run real-data tests. Check the target with \`augmentworks target list\`, finish verifying it with \`augmentworks target verify <name>\`, then create a scope with \`augmentworks scope create --target <name> --suite <file>\`. (TARGET_AUTHORITY_REQUIRED)"`;

exports[`plain-language real-data errors (AUG-366) > target scope mismatch 1`] = `"Error: target.base_url in augmentworks.yaml points at https://staging.example.com, but this scope's target is registered at https://bot.example.com. Set base_url to https://bot.example.com, or register https://staging.example.com as its own target. A loopback address is transport only and can't stand in for a registered public address. \`augmentworks target pull <name>\` copies the registered address and endpoints into augmentworks.yaml, and \`augmentworks target list\` shows them. (TARGET_SCOPE_MISMATCH)"`;

exports[`plain-language real-data errors (AUG-366) > verification expired 1`] = `"Error: This target's verification expired at 2026-10-01T00:00:00Z. Renew it with \`augmentworks target verify <name>\` (Settings → Targets shows when renewal opens), then create a new scope with \`augmentworks scope create --target <name> --suite <file>\`. (TARGET_AUTHORITY_EXPIRED)"`;
