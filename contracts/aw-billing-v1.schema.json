{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://augmentworks.ai/contracts/aw-billing-v1.schema.json",
  "title": "AugmentWorks billing contract",
  "description": "Canonical aw-billing/1 wire contract owned by augmentworks-org/augmentworks. Stage 5 advertises usage_v1, quote_v1, status_v1, billing_portal_link_v1, and subscriptions_v1. Request validation is strict. Response consumers must tolerate documented additive optional fields and ignore unknown capability strings. Unknown financial/access states must never be guessed active or safe. A pending pack purchase is optional additive metadata and is never spendable credit. Live subscription sales remain an operational gate, not a wire-capability gate.",
  "type": "object",
  "$defs": {
    "schemaVersion": {
      "const": "aw-billing/1"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp in UTC with a Z suffix. Millisecond precision is permitted; producers emit milliseconds."
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hex SHA-256 digest."
    },
    "unitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "executionUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "description": "Customer execution units for one quoted assessment. One unit is one scenario repetition against one target."
    },
    "maxCredits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Optional nonnegative safe integer ceiling on customer execution units, not provider dollars. Zero rejects every positive-unit run and does not grant a free hosted run."
    },
    "ledgerRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic per billing account. Duplicate idempotent replays must not change it."
    },
    "accessState": {
      "type": "string",
      "enum": ["active", "past_due", "suspended", "closing", "closed"],
      "description": "Workspace access/lifecycle projection. This is not the unit balance. An active workspace may have zero available units. Unknown values must not be guessed active or safe."
    },
    "grantOrigin": {
      "type": "string",
      "enum": [
        "trial",
        "legacy_imported",
        "purchased",
        "subscription",
        "adjustment",
        "migration"
      ]
    },
    "advertisedCapability": {
      "type": "string",
      "enum": [
        "usage_v1",
        "quote_v1",
        "status_v1",
        "billing_portal_link_v1",
        "subscriptions_v1"
      ]
    },
    "reservedCapability": {
      "description": "No capability names remain reserved after Stage 5A. Consumers still ignore unknown capability strings.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$",
      "description": "Consumers ignore unknown capability strings. Servers must not advertise unimplemented capabilities."
    },
    "grantBalance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "lotId",
        "origin",
        "grantedUnits",
        "availableUnits",
        "reservedUnits",
        "consumedUnits",
        "expiresAt",
        "grantedAt"
      ],
      "properties": {
        "lotId": { "$ref": "#/$defs/uuid" },
        "origin": { "$ref": "#/$defs/grantOrigin" },
        "grantedUnits": { "$ref": "#/$defs/unitCount" },
        "availableUnits": { "$ref": "#/$defs/unitCount" },
        "reservedUnits": { "$ref": "#/$defs/unitCount" },
        "consumedUnits": { "$ref": "#/$defs/unitCount" },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "grantedAt": { "$ref": "#/$defs/utcTimestamp" },
        "policyVersion": { "type": "string", "maxLength": 64 },
        "forfeitedUnits": { "$ref": "#/$defs/unitCount" },
        "frozenUnits": { "$ref": "#/$defs/unitCount" }
      }
    },
    "subscription": {
      "description": "Nullable subscription projection. Null means no subscription on this billing account. Stage 5A producers emit the object when a local subscription row exists. Consumers ignore unsupported optional details and unknown status strings. Do not guess access from a raw provider id. CLI must not calculate renewal dates or grant quantities.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "planCode",
            "status",
            "cancelAtPeriodEnd",
            "nextPaymentAction"
          ],
          "properties": {
            "planCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Server catalog SKU such as pro_monthly_1000_v1."
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Provider-neutral projection. Known values: active, canceling, past_due, unpaid, incomplete, incomplete_expired, canceled, processing, unsupported, unknown. Unknown values must not be guessed active or safe."
            },
            "currentPeriodStart": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "currentPeriodEnd": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "cancelAtPeriodEnd": { "type": "boolean" },
            "nextPaymentAction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Known values: none, authenticate, update_payment_method, processing."
            },
            "monthlyGrant": {
              "description": "Current funded monthly lot summary for the projected service period. Null when no monthly lot is attached. Pack lots are never included.",
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "grantedUnits",
                    "availableUnits",
                    "reservedUnits",
                    "consumedUnits",
                    "expiresAt"
                  ],
                  "properties": {
                    "grantedUnits": { "$ref": "#/$defs/unitCount" },
                    "availableUnits": { "$ref": "#/$defs/unitCount" },
                    "reservedUnits": { "$ref": "#/$defs/unitCount" },
                    "consumedUnits": { "$ref": "#/$defs/unitCount" },
                    "expiresAt": {
                      "type": ["string", "null"],
                      "format": "date-time"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "usageResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "workspaceId",
        "billingAccountId",
        "asOf",
        "ledgerRevision",
        "accessState",
        "availableUnits",
        "reservedUnits",
        "consumedUnits",
        "grantBalances",
        "subscription",
        "billingPageUrl",
        "capabilities"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "billingAccountId": { "$ref": "#/$defs/uuid" },
        "asOf": { "$ref": "#/$defs/utcTimestamp" },
        "ledgerRevision": { "$ref": "#/$defs/ledgerRevision" },
        "accessState": { "$ref": "#/$defs/accessState" },
        "availableUnits": { "$ref": "#/$defs/unitCount" },
        "reservedUnits": { "$ref": "#/$defs/unitCount" },
        "consumedUnits": {
          "allOf": [{ "$ref": "#/$defs/unitCount" }],
          "description": "Net consumed units after approved compensation."
        },
        "grantBalances": {
          "type": "array",
          "items": { "$ref": "#/$defs/grantBalance" }
        },
        "subscription": { "$ref": "#/$defs/subscription" },
        "billingPageUrl": {
          "type": "string",
          "format": "uri"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capability" }
        },
        "grossConsumedUnits": { "$ref": "#/$defs/unitCount" },
        "compensatedUnits": { "$ref": "#/$defs/unitCount" },
        "releasedUnits": { "$ref": "#/$defs/unitCount" },
        "cutoverVersion": { "type": ["string", "null"] },
        "pendingCommerce": {
          "description": "Optional additive snapshot of a non-terminal pack order. It is not spendable credit. Absent or null means no pending purchase. CLI Stage 3B may ignore this field.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": true,
              "required": ["orderId", "state", "skuCode"],
              "properties": {
                "orderId": { "$ref": "#/$defs/uuid" },
                "state": { "type": "string" },
                "skuCode": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "capabilitiesResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "asOf", "capabilities"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "asOf": { "$ref": "#/$defs/utcTimestamp" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/advertisedCapability" }
        },
        "workspaceId": { "$ref": "#/$defs/uuid" }
      }
    },
    "quoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packet",
        "config_sha256",
        "target",
        "assessment"
      ],
      "description": "POST /v1/billing/quote body. Reuses the canonical aw-relay/0.2 assessment/compiler input. Does not reserve units, create a run, hydrate jobs, call a model, or contact the target. Client-supplied executionUnits and assessmentPlanHash are ignored as proof.",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "packet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "version"],
          "properties": {
            "key": { "type": "string", "minLength": 1, "maxLength": 300 },
            "version": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        },
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "boundary_sha256", "capabilities"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "boundary_sha256": { "$ref": "#/$defs/sha256" },
            "capabilities": { "type": "object" }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_hash",
            "profile",
            "evaluation_mode",
            "disclosure_version",
            "reference_bundle"
          ],
          "properties": {
            "plan_hash": { "$ref": "#/$defs/sha256" },
            "profile": {
              "type": "string",
              "enum": ["quick", "full", "combined", "custom"]
            },
            "evaluation_mode": {
              "type": "string",
              "enum": ["deterministic", "hybrid"]
            },
            "disclosure_version": { "type": ["string", "null"], "maxLength": 80 },
            "selected_scenario_ids": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string" }
            },
            "packet_bindings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "version"],
                "properties": {
                  "key": { "type": "string" },
                  "version": { "type": "string" }
                }
              }
            },
            "reference_bundle": { "type": "object" }
          }
        }
      }
    },
    "quoteResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "quoteId",
        "workspaceId",
        "assessmentPlanHash",
        "pricingVersion",
        "executionUnits",
        "expiresAt",
        "availableUnitsAtQuote",
        "estimateOnly"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "quoteId": { "$ref": "#/$defs/uuid" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "assessmentPlanHash": { "$ref": "#/$defs/sha256" },
        "pricingVersion": {
          "type": "string",
          "const": "aw-pricing/execution-unit/1"
        },
        "executionUnits": { "$ref": "#/$defs/executionUnitCount" },
        "expiresAt": { "$ref": "#/$defs/utcTimestamp" },
        "availableUnitsAtQuote": { "$ref": "#/$defs/unitCount" },
        "estimateOnly": { "const": true },
        "scenarioCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 3 },
        "remainingUnitsEstimate": { "$ref": "#/$defs/unitCount" },
        "retentionPolicyVersion": {
          "type": "string",
          "description": "Deterministic run-detail retention policy bound at quote time. Distinct from purchased-credit validity."
        },
        "retainUntil": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "quotedCreateRequestFields": {
      "description": "Additive aw-relay/0.3 create-request fields. Existing 0.1/0.2 objects remain strict and must not carry these keys. Wire names are snake_case to match create_request_id. Billing JSON uses quoteId/maxCredits; relay create uses quote_id/max_credits.",
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "create_request_id", "quote_id"],
      "properties": {
        "protocol_version": { "const": "aw-relay/0.3" },
        "create_request_id": {
          "type": "string",
          "minLength": 24,
          "maxLength": 100,
          "pattern": "^crq_[A-Za-z0-9_-]+$"
        },
        "quote_id": { "$ref": "#/$defs/uuid" },
        "max_credits": { "$ref": "#/$defs/maxCredits" }
      }
    },
    "runStatusResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "runId",
        "workspaceId",
        "originalRunId",
        "executionStatus",
        "evaluationStatus",
        "credit",
        "progress",
        "savedEvidence",
        "retryEligible",
        "retryReason",
        "nextActions",
        "dashboardUrl",
        "asOf"
      ],
      "description": "GET /v1/billing/status?runId=. Status reads never start execution, consume units, call providers, or retry evaluation. Canonical execution status remains GET /v1/relay/runs/{runId} for 1B-compatible required fields.",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "runId": { "$ref": "#/$defs/uuid" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "originalRunId": { "$ref": "#/$defs/uuid" },
        "executionStatus": { "type": "string" },
        "evaluationStatus": {
          "type": "string",
          "enum": [
            "absent",
            "pending",
            "complete",
            "partial",
            "error",
            "unsupported"
          ]
        },
        "credit": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "reservedUnits",
            "consumedUnits",
            "releasedUnits",
            "compensatedUnits"
          ],
          "properties": {
            "reservedUnits": { "$ref": "#/$defs/unitCount" },
            "consumedUnits": { "$ref": "#/$defs/unitCount" },
            "releasedUnits": { "$ref": "#/$defs/unitCount" },
            "compensatedUnits": { "$ref": "#/$defs/unitCount" }
          }
        },
        "progress": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "completedAttempts",
            "plannedAttempts",
            "completedJudgeJobs",
            "plannedJudgeJobs"
          ],
          "properties": {
            "completedAttempts": { "type": "integer", "minimum": 0 },
            "plannedAttempts": { "type": "integer", "minimum": 0 },
            "completedJudgeJobs": { "type": "integer", "minimum": 0 },
            "plannedJudgeJobs": { "type": "integer", "minimum": 0 }
          }
        },
        "savedEvidence": { "type": "boolean" },
        "retryEligible": { "type": "boolean" },
        "retryReason": { "type": ["string", "null"], "maxLength": 300 },
        "nextActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "wait",
              "inspect",
              "retry_evaluation",
              "open_dashboard",
              "none"
            ]
          }
        },
        "dashboardUrl": { "type": "string", "format": "uri" },
        "asOf": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "stableBillingCode": {
      "type": "string",
      "enum": [
        "BILLING_UNAVAILABLE",
        "INSUFFICIENT_CREDITS",
        "QUOTE_EXPIRED",
        "QUOTE_MISMATCH",
        "BUDGET_EXCEEDED",
        "UPDATE_REQUIRED",
        "WORKSPACE_CLOSING",
        "MEMBERSHIP_REVOKED"
      ]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "unauthorized",
        "insufficient_scope",
        "invalid_request",
        "workspace_mismatch",
        "billing_unprovisioned",
        "unsupported_state",
        "conflict",
        "service_unavailable",
        "insufficient_credits",
        "quote_expired",
        "quote_mismatch",
        "budget_exceeded",
        "update_required",
        "workspace_closing",
        "membership_revoked"
      ]
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "error"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "error": {
          "type": "object",
          "additionalProperties": true,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "$ref": "#/$defs/errorCode" },
            "message": { "type": "string", "minLength": 1, "maxLength": 300 },
            "retryable": { "type": "boolean" },
            "billingCode": { "$ref": "#/$defs/stableBillingCode" }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/usageResponse" },
    { "$ref": "#/$defs/capabilitiesResponse" },
    { "$ref": "#/$defs/quoteRequest" },
    { "$ref": "#/$defs/quoteResponse" },
    { "$ref": "#/$defs/runStatusResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ]
}
