{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/augmentworks-org/augmentworks-cli/blob/main/contracts/discovery-manifest.schema.json",
  "title": "AugmentWorks CLI discovery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "runtime",
    "capabilities",
    "commands",
    "site",
    "docs",
    "reportFormats",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "releaseStatus"],
      "properties": {
        "name": { "const": "@augmentworks/cli" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "releaseStatus": { "enum": ["development", "published"] }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localDemo", "localTest", "hostedAssessment", "agentGuide"],
      "properties": {
        "localDemo": { "type": "boolean" },
        "localTest": { "type": "boolean" },
        "hostedAssessment": { "type": "boolean" },
        "agentGuide": { "type": "boolean" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localDemo", "localTest", "doctor", "hostedAssessment"],
      "properties": {
        "localDemo": { "$ref": "#/$defs/commandVector" },
        "localTest": { "$ref": "#/$defs/commandVector" },
        "doctor": { "$ref": "#/$defs/commandVector" },
        "hostedAssessment": { "$ref": "#/$defs/commandVector" }
      }
    },
    "site": { "const": "https://augmentworks.ai" },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quickstart", "localQuickstart", "agentSetup"],
      "properties": {
        "quickstart": { "type": "string", "format": "uri" },
        "localQuickstart": { "type": "string", "format": "uri" },
        "agentSetup": { "type": "string", "format": "uri" }
      }
    },
    "reportFormats": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "verifiedAt"],
      "properties": {
        "sourceCommit": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          ]
        },
        "verifiedAt": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      }
    }
  },
  "$defs": {
    "commandVector": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      ]
    }
  }
}
