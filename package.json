{
  "name": "@augmentworks/cli",
  "version": "0.3.8",
  "description": "Deterministic hosted and customer-executed local testing for AI agents",
  "type": "module",
  "bin": {
    "augmentworks": "dist/index.js"
  },
  "files": [
    "dist",
    "packets",
    "schemas",
    "assets",
    "contracts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run check:discovery && npm run check:billing-contract && npm run check:run-report-contract && npm run check:real-data-contract",
    "generate:discovery": "tsx scripts/generate-discovery-manifest.mjs",
    "generate:agent-resources": "tsx scripts/generate-agent-resources.mjs",
    "generate:demo-examples": "tsx scripts/generate-demo-examples.mjs",
    "check:discovery": "tsx scripts/check-discovery-manifest.mjs",
    "generate:billing-contract": "node scripts/import-aw-billing-contract.mjs",
    "check:billing-contract": "node scripts/check-aw-billing-contract.mjs",
    "check:run-report-contract": "node scripts/check-aw-run-report-contract.mjs",
    "check:real-data-contract": "node scripts/check-aw-real-data-contract.mjs",
    "test:packed-real-data-privacy": "node scripts/packed-real-data-privacy.mjs",
    "test:packed-action-gate": "node scripts/packed-action-gate-permit.mjs",
    "test:packed-report-fixture": "node scripts/packed-report-fixture.mjs",
    "test:integration:recovery": "vitest run test/recovery/recovery.test.ts test/integration/create-resume.test.ts test/integration/cli-entry.test.ts",
    "test:e2e:cli-auth": "vitest run test/auth/loopback-callback.test.ts",
    "audit:ci": "npm audit --audit-level=high",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "test:packed-billing-fixture": "node scripts/packed-billing-fixture.mjs",
    "test:packed-billing-live": "node scripts/packed-billing-live.mjs",
    "test:packed-core-release": "node scripts/packed-core-release-acceptance.mjs --source registry --version 0.3.4",
    "test:packed-core-release:local": "node scripts/packed-core-release-acceptance.mjs --source local",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run audit:ci && npm run smoke:pack"
  },
  "keywords": [
    "augmentworks",
    "ai-evaluation",
    "agent-testing",
    "chatbot-testing",
    "local-ai-testing",
    "offline-evaluation",
    "cli",
    "regression-testing"
  ],
  "author": "AugmentWorks",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeffskafi/augmentworks-cli.git"
  },
  "bugs": {
    "url": "https://github.com/jeffskafi/augmentworks-cli/issues"
  },
  "homepage": "https://augmentworks.ai",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "commander": "15.0.0",
    "open": "11.0.4",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
