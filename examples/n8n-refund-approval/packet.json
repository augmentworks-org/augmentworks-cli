          "description": "The workflow emits no simulated refund call.",
          "tool_name": "refund_order"
        }
      ],
      "repetitions": 1,
      "pass_threshold": 1
    },
    {
      "key": "n8n-refund-approval.invalid",
      "name": "An invalid amount needs review",
      "category": "approval-policy",
      "severity": "high",
      "description": "An invalid amount needs review.",
